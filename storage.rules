rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'imdad.builds@gmail.com'
      );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isReasonableSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Public read for studio assets, admin write only
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isReasonableSize();
    }
  }
}
